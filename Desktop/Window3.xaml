        <CheckBox x:Name="checkBox" Style="{DynamicResource Чек1бокс}" Content="Go fishing with Stephen" HorizontalAlignment="Left" Margin="168,146,0,0" VerticalAlignment="Top" Height="57" Width="259" VerticalContentAlignment="Center" BorderThickness="3,3,3,3" SnapsToDevicePixels="True" Padding="4,-1,0,0" UseLayoutRounding="True" ScrollViewer.CanContentScroll="True" FontSize="20" Checked="CheckBox_Checked"/>
