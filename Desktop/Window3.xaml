        <Button Content="Дом" HorizontalAlignment="Left" Margin="159,28,0,0" VerticalAlignment="Top" Click="Button_Click" Height="30" Width="76" BorderBrush="White" Background="White" FontSize="22" Foreground="#FF85DF7D"/>
        <Button Content="Работа" HorizontalAlignment="Left" Margin="254,28,0,0" VerticalAlignment="Top" Click="Button_Click" Height="30" Width="76" BorderBrush="White" Background="White" FontSize="22" Foreground="#FFEE9E1D"/>
